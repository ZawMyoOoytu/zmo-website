{
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/admin/(.*)", "dest": "/admin-panel/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}